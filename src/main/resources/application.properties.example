server.error.include-message=${SERVER_ERROR_INCLUDE_MESSAGE:never}
server.error.include-binding-errors=${SERVER_ERROR_INCLUDE_BINDING_ERRORS:never}

# =============================================================================
# BANCO DE DADOS H2 (apenas para desenvolvimento/testes)
# Em produção, substitua pelo driver do banco real (PostgreSQL, MySQL etc.)
# =============================================================================
spring.datasource.url=jdbc:h2:mem:teste-security;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
spring.datasource.driver-class-name=org.h2.Driver
spring.h2.console.enabled=${H2_CONSOLE_ENABLED:false}
spring.datasource.username=${DB_USERNAME:admin}
spring.datasource.password=${DB_PASSWORD:admin}

# Hibernate cria o esquema a partir das entidades @Entity
spring.jpa.hibernate.ddl-auto=create-drop
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.H2Dialect
spring.sql.init.mode=always

# Garante que o data.sql seja executado após o schema JPA ser criado
spring.jpa.defer-datasource-initialization=true

logging.level.org.springframework.security=${SPRING_SECURITY_LOG_LEVEL:WARN}

# =============================================================================
# CONFIGURAÇÕES JWT
# =============================================================================

# Tempo de validade do token em SEGUNDOS
# 3600 = 1 hora | 86400 = 24 horas | 604800 = 7 dias
# Em produção: tokens de curta duração (15-60 min) + refresh token são mais seguros
jwt.validity=${JWT_VALIDITY:3600}

# Chave secreta para assinar os tokens (algoritmo HMAC-SHA256)
# REQUISITOS:
#   - Deve estar codificada em Base64
#   - Mínimo de 32 bytes após decodificação (256 bits para HS256)
# ATENÇÃO:
#   - Em produção, defina a variável de ambiente JWT_SECRET com uma chave forte
#   - Nunca commite chaves reais no repositório Git

jwt.secret=${JWT_SECRET:}

# =============================================================================
# PROTEÇÃO CONTRA BRUTE FORCE NO LOGIN
# =============================================================================
security.login.max-failed-attempts=${LOGIN_MAX_FAILED_ATTEMPTS:5}
security.login.lock-duration-minutes=${LOGIN_LOCK_DURATION_MINUTES:15}
