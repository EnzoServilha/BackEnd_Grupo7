server.error.include-message=${SERVER_ERROR_INCLUDE_MESSAGE:never}
server.error.include-binding-errors=${SERVER_ERROR_INCLUDE_BINDING_ERRORS:never}

# =============================================================================
# BANCO DE DADOS MYSQL (Produção / Desenvolvimento)
# =============================================================================
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:sua_base_de_dados}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:sua_senha}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hibernate atualiza o esquema automaticamente sem apagar os dados
spring.jpa.hibernate.ddl-auto=${DB_DDL_AUTO:update}
spring.jpa.show-sql=${SPRING_JPA_SHOW_SQL:false}

# Desativa scripts automáticos de inicialização para evitar duplicidade de chaves
spring.sql.init.mode=never
spring.jpa.defer-datasource-initialization=true

logging.level.org.springframework.security=${SPRING_SECURITY_LOG_LEVEL:WARN}

# =============================================================================
# CONFIGURAÇÕES JWT
# =============================================================================
jwt.validity=${JWT_VALIDITY:3600}
jwt.secret=${JWT_SECRET:}
COOKIE_SECURE=${COOKIE_SECURE:false}

# =============================================================================
# CONFIGURAÇÃO DE E-MAIL (JavaMailSender)
# =============================================================================
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:seu_email@gmail.com}
spring.mail.password=${MAIL_PASSWORD:sua_senha_de_app_aqui}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.ssl.properties.mail.smtp.ssl.protocols=TLSv1.2 TLSv1.3

# =============================================================================
# PROTEÇÃO CONTRA BRUTE FORCE NO LOGIN
# =============================================================================
security.login.max-failed-attempts=${LOGIN_MAX_FAILED_ATTEMPTS:5}
security.login.lock-duration-minutes=${LOGIN_LOCK_DURATION_MINUTES:15}