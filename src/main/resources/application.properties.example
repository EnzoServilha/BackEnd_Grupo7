spring.web.error.include-message=always
spring.web.error.include-binding-errors=always

# =============================================================================
# BANCO DE DADOS H2 (apenas para desenvolvimento/testes)
# Em produção, substitua pelo driver do banco real (PostgreSQL, MySQL etc.)
# =============================================================================
spring.datasource.url=jdbc:h2:mem:teste-security
spring.h2.console.enabled=true
spring.datasource.username=${DB_USERNAME:}
spring.datasource.password=${DB_PASSWORD:}
spring.jpa.hibernate.ddl-auto=create-drop
spring.sql.init.mode=always

# Garante que o data.sql seja executado após o schema JPA ser criado
spring.jpa.defer-datasource-initialization=true

logging.level.org.springframework.security=TRACE

# =============================================================================
# CONFIGURAÇÕES JWT
# =============================================================================

jwt.validity=${JWT_VALIDITY:3600}

jwt.secret=${JWT_SECRET:}
