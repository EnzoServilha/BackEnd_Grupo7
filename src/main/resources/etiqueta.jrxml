<?xml version="1.0" encoding="UTF-8"?>
<!--
    Etiqueta 70 x 50 mm em orientação Landscape
    Conversão: 1 mm = 72 / 25.4 ≈ 2.8346 px (unidade do JasperReports)
      largura : 70 mm × 2.8346 ≈ 198 px
      altura  : 50 mm × 2.8346 ≈ 142 px
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              name="etiqueta"
              pageWidth="198"
              pageHeight="142"
              orientation="Landscape"
              columnWidth="198"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0">

    <parameter name="codigoInterno" class="java.lang.String"/>
    <parameter name="marca" class="java.lang.String"/>
    <parameter name="descricao" class="java.lang.String"/>
    <parameter name="dataCadastro" class="java.lang.String"/>

    <title>
        <band height="142" splitType="Stretch">

            <!-- Código Interno - Centralizado no topo -->
            <textField>
                <reportElement x="0" y="6" width="198" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{codigoInterno}]]></textFieldExpression>
            </textField>

            <!-- Linha separadora -->
            <line>
                <reportElement x="6" y="28" width="186" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <!-- Marca (campo com label) -->
            <textField>
                <reportElement x="6" y="34" width="186" height="14"/>
                <textElement textAlignment="Left">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Marca: " + $P{marca}]]></textFieldExpression>
            </textField>

            <!-- Descrição (campo com label) -->
            <textField>
                <reportElement x="6" y="52" width="186" height="60"/>
                <textElement textAlignment="Left">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Descrição: " + $P{descricao}]]></textFieldExpression>
            </textField>

            <!-- Data de Cadastro - Canto inferior direito -->
            <textField>
                <reportElement x="80" y="120" width="112" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Bottom">
                    <font fontName="SansSerif" size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{dataCadastro}]]></textFieldExpression>
            </textField>

        </band>
    </title>

</jasperReport>
